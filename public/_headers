# Cabeceras de seguridad (Cloudflare Pages las lee de aqui). La app no tiene backend ni carga nada
# de terceros: todo es del mismo origen. `unsafe-inline` en style-src es por los estilos en
# linea de las tarjetas y el mapa nocturno; en script-src no hace falta.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cache: los assets llevan hash en el nombre (inmutables); el HTML, el service worker y el
# manifiesto se revalidan siempre, para que una version nueva llegue en la siguiente visita.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
